{
  "name": "obsidianpreview",
  "displayName": "Obsidian for Cursor",
  "description": "Preview and navigate your Obsidian vault in Cursor/VS Code with full plugin support",
  "version": "1.0.18",
  "icon": "icon.png",
  "publisher": "px39n",
  "author": {
    "name": "px39n"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/px39n/obs_cursor"
  },
  "bugs": {
    "url": "https://github.com/px39n/obs_cursor/issues"
  },
  "homepage": "https://github.com/px39n/obs_cursor#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "obsidian",
    "markdown",
    "preview",
    "wikilink",
    "dataview"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "obsidian-preview.open",
        "title": "Obsidian Preview: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "obsidian-preview.openDebug",
        "title": "Obsidian Preview: Open Debug Preview",
        "icon": "$(debug)"
      },
      {
        "command": "obsidian-preview.connect",
        "title": "Obsidian Preview: Connect to Obsidian"
      },
      {
        "command": "obsidian-preview.openLog",
        "title": "Obsidian Preview: Open Log File"
      },
      {
        "command": "obsidian-preview.clearLog",
        "title": "Obsidian Preview: Clear Log File"
      },
      {
        "command": "obsidian-preview.uploadToImgur",
        "title": "Obsidian Preview: Upload Image to Imgur",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "obsidian-preview.pasteImageToImgur",
        "title": "Obsidian Preview: Paste Image to Imgur"
      },
      {
        "command": "obsidian-preview.openObsidian",
        "title": "Obsidian Preview: Open Obsidian Vault"
      },
      {
        "command": "obsidian-preview.updateVaultPath",
        "title": "Obsidian Preview: Update Vault Path"
      },
      {
        "command": "obsidian-preview.updateObsidianPlugin",
        "title": "Obsidian Preview: Update Obsidian Plugin"
      }
    ],
    "keybindings": [
      {
        "command": "obsidian-preview.pasteImageToImgur",
        "key": "ctrl+shift+v",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "obsidian-preview.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Obsidian Preview",
      "properties": {
        "obsidianPreview.port": {
          "type": "number",
          "default": 27123,
          "description": "Port for Obsidian render server"
        },
        "obsidianPreview.vaultPath": {
          "type": "string",
          "default": "",
          "description": "Path to your Obsidian vault (auto-detected if left empty)"
        },
        "obsidianPreview.autoOpenPreview": {
          "type": "boolean",
          "default": true,
          "description": "When true, opening or focusing a Markdown editor automatically opens the Obsidian preview (if not already open)."
        },
        "obsidianPreview.previewInSecondEditorGroup": {
          "type": "boolean",
          "default": true,
          "description": "When true, keep Markdown in the first editor group and open the preview in the second group so new files from the explorer usually land beside the source, not the webview. Set false to use the previous “open beside active editor” behavior."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
